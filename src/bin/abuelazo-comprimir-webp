#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
if [[ ! -f $LIB ]]; then
  printf 'No se encontró la librería común de Abuelazo.\n' >&2
  exit 1
fi
source "$LIB"
aba_requerir_args 1 9999 "$#"
ARCHIVOS=()
for ARGUMENTO in "$@"; do
  ARCHIVOS+=("$(aba_decodificar_uri "$ARGUMENTO")")
done
LOG=$(aba_log_temporal 'webp')
trap 'rm -f -- "$LOG"' EXIT
aba_requerir cwebp
CONTADOR=0
for ARCHIVO in "${ARCHIVOS[@]}"; do
  [[ -f $ARCHIVO ]] || aba_error "No se encuentra la imagen: $ARCHIVO"
  EXTENSION="${ARCHIVO##*.}"
  EXTENSION="${EXTENSION,,}"
  case "$EXTENSION" in
    jpg|jpeg|png|gif|bmp|tif|tiff|webp) ;;
    *) aba_error "Formato de imagen no admitido: $ARCHIVO" ;;
  esac
  BASE="${ARCHIVO%.*}"
  SALIDA=$(aba_salida_unica "$BASE" "webp")
  if ! cwebp -quiet -q 80 -o "$SALIDA" "$ARCHIVO" >"$LOG" 2>&1; then
    DETALLES=$(<"$LOG")
    aba_error "No se pudo comprimir la imagen. $DETALLES"
  fi
  [[ -f $SALIDA ]] || aba_error "No se creó el WebP de $ARCHIVO"
  CONTADOR=$((CONTADOR + 1))
done
DIRECTORIO=$(dirname -- "${ARCHIVOS[0]}")
aba_resultado "Imágenes WebP creadas: $CONTADOR" "$DIRECTORIO"
