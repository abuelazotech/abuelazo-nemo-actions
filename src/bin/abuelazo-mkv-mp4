#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
[[ -f $LIB ]] || { printf 'No se encontró la librería común de Abuelazo.\n' >&2; exit 1; }
. "$LIB"

aba_requerir_args 1 1 "$#"
ARCHIVO=$(aba_decodificar_uri "$1")
[[ -f $ARCHIVO ]] || aba_error 'No se encuentra el archivo seleccionado.'
aba_requerir ffmpeg
BASE="${ARCHIVO%.*}"
[[ $ARCHIVO == *.* ]] || BASE="$ARCHIVO"
SALIDA=$(aba_salida_unica "$BASE" mp4)
[[ ! -e $SALIDA ]] || aba_error 'El archivo MP4 de salida ya existe.'
LOG=$(aba_log_temporal mkv)
trap 'rm -f -- "$LOG"' EXIT
if ffmpeg -nostdin -n -i "$ARCHIVO" -c copy -movflags +faststart "$SALIDA" >"$LOG" 2>&1; then
  aba_resultado 'Convertido a MP4 sin recodificar' "$SALIDA"
  exit 0
fi
if [[ -e $SALIDA ]]; then
  rm -f -- "$SALIDA"
fi
aba_notificar "$ABA_TITULO" 'El audio no es compatible con MP4; se reintenta con AAC.'
if ffmpeg -nostdin -n -i "$ARCHIVO" -c:v copy -c:a aac -b:a 192k -sn -movflags +faststart "$SALIDA" >>"$LOG" 2>&1; then
  aba_resultado 'Convertido a MP4 con audio AAC' "$SALIDA"
else
  aba_error 'No se pudo convertir el video a MP4.'
fi
