#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
[[ -f $LIB ]] || { printf 'No se encontró la librería común de Abuelazo.\n' >&2; exit 1; }
. "$LIB"

aba_requerir_args 1 1 "$#"
ARCHIVO=$(aba_decodificar_uri "$1")
[[ -f $ARCHIVO ]] || aba_error 'No se encuentra el archivo seleccionado.'
aba_requerir ffmpeg
BASE="${ARCHIVO%.*}"
[[ $ARCHIVO == *.* ]] || BASE="$ARCHIVO"
SALIDA=$(aba_salida_unica "$BASE" mp3)
[[ ! -e $SALIDA ]] || aba_error 'El archivo MP3 de salida ya existe.'
LOG=$(aba_log_temporal audio)
trap 'rm -f -- "$LOG"' EXIT
if ffmpeg -nostdin -n -i "$ARCHIVO" -vn -c:a libmp3lame -q:a 2 "$SALIDA" >"$LOG" 2>&1; then
  aba_resultado 'Audio extraído' "$SALIDA"
else
  aba_error 'No se pudo extraer el audio.'
fi
