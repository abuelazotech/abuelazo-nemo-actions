#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
if [[ ! -f $LIB ]]; then
  printf 'No se encontró la librería común de Abuelazo.\n' >&2
  exit 1
fi
source "$LIB"
aba_requerir_args 1 9999 "$#"
ARCHIVOS=()
for ARGUMENTO in "$@"; do
  ARCHIVOS+=("$(aba_decodificar_uri "$ARGUMENTO")")
done
LOG=$(aba_log_temporal 'rotar')
trap 'rm -f -- "$LOG"' EXIT
if command -v magick >/dev/null 2>&1; then
  IM=magick
else
  IM=convert
fi
aba_requerir zenity "$IM"
ANGULO=$(zenity --list --radiolist --column='' --column='Angulo' TRUE 90 FALSE 180 FALSE 270) || aba_error 'No se seleccionó el ángulo'
case "$ANGULO" in
  90|180|270) ;;
  *) aba_error 'El ángulo debe ser 90, 180 o 270' ;;
esac
CONTADOR=0
for ARCHIVO in "${ARCHIVOS[@]}"; do
  [[ -f $ARCHIVO ]] || aba_error "No se encuentra la imagen: $ARCHIVO"
  EXTENSION="${ARCHIVO##*.}"
  EXTENSION="${EXTENSION,,}"
  case "$EXTENSION" in
    jpg|jpeg|png|gif|bmp|tif|tiff|webp) ;;
    *) aba_error "Formato de imagen no admitido: $ARCHIVO" ;;
  esac
  BASE="${ARCHIVO%.*}"
  SALIDA=$(aba_salida_unica_sufijo "$BASE" "_rotada" "$EXTENSION")
  if ! "$IM" "$ARCHIVO" -rotate "$ANGULO" "$SALIDA" >"$LOG" 2>&1; then
    DETALLES=$(<"$LOG")
    aba_error "No se pudo rotar la imagen. $DETALLES"
  fi
  [[ -f $SALIDA ]] || aba_error "No se creó la imagen rotada de $ARCHIVO"
  CONTADOR=$((CONTADOR + 1))
done
DIRECTORIO=$(dirname -- "${ARCHIVOS[0]}")
aba_resultado "Imágenes rotadas: $CONTADOR" "$DIRECTORIO"
