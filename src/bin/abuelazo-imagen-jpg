#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
[[ -f $LIB ]] || { printf 'No se encontró la librería común de Abuelazo.\n' >&2; exit 1; }
. "$LIB"

aba_requerir_args 1 1 "$#"
ARCHIVO=$(aba_decodificar_uri "$1")
[[ -f $ARCHIVO ]] || aba_error 'No se encuentra la imagen seleccionada.'
if command -v magick >/dev/null 2>&1; then
  IM=magick
else
  IM=convert
fi
aba_requerir "$IM"
BASE="${ARCHIVO%.*}"
[[ $ARCHIVO == *.* ]] || BASE="$ARCHIVO"
SALIDA=$(aba_salida_unica "$BASE" jpg)
[[ ! -e $SALIDA ]] || aba_error 'La imagen de salida ya existe.'
LOG=$(aba_log_temporal jpg)
trap 'rm -f -- "$LOG"' EXIT
if "$IM" "${ARCHIVO}[0]" -auto-orient -background white -flatten -quality 92 -strip "$SALIDA" >"$LOG" 2>&1; then
  aba_resultado 'Imagen convertida a JPG' "$SALIDA"
else
  aba_error 'No se pudo convertir la imagen a JPG.'
fi
