#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
[[ -f $LIB ]] || { printf 'No se encontró la librería común de Abuelazo.\n' >&2; exit 1; }
. "$LIB"

aba_requerir_args 2 2 "$#"
EXTENSION="${1,,}"
CARPETA=$(aba_decodificar_uri "$2")
case "$EXTENSION" in
  odt) BASE='Nuevo_Documento' ;;
  ods) BASE='Nueva_Hoja_De_Calculo' ;;
  odp) BASE='Nueva_Presentacion' ;;
  odg) BASE='Nuevo_Dibujo' ;;
  odf) BASE='Nueva_Formula' ;;
  odb) BASE='Nueva_Base_De_Datos' ;;
  *) aba_error "Extensión no admitida: $EXTENSION" ;;
esac
[[ -d $CARPETA ]] || aba_error 'La carpeta indicada no existe.'
SALIDA=$(aba_salida_unica "$CARPETA/$BASE" "$EXTENSION")
[[ ! -e $SALIDA ]] || aba_error 'El documento de salida ya existe.'
if ! touch "$SALIDA" 2>/dev/null; then
  aba_error 'No se pudo crear el documento. Revisa los permisos de la carpeta.'
fi
if command -v libreoffice >/dev/null 2>&1; then
  libreoffice "$SALIDA" >/dev/null 2>&1 &
  MENSAJE="Documento creado y abierto: $(basename -- "$SALIDA")"
else
  MENSAJE="Documento creado, pero LibreOffice no está disponible: $(basename -- "$SALIDA")"
fi
aba_resultado "$MENSAJE" "$SALIDA"
