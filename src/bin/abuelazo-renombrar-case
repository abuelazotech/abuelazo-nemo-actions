#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
[[ -f $LIB ]] || { printf 'No se encontró la librería común de Abuelazo.\n' >&2; exit 1; }
. "$LIB"

aba_requerir_args 2 "$#" "$#"
MODO="${1,,}"
case "$MODO" in
  lower|upper) ;;
  *) aba_error 'El modo debe ser lower o upper.' ;;
esac
shift
ORIGINALES=()
DESTINOS=()
for ARGUMENTO in "$@"; do
  ARCHIVO=$(aba_decodificar_uri "$ARGUMENTO")
  [[ -f $ARCHIVO ]] || aba_error "No se encuentra el archivo: $ARCHIVO"
  NOMBRE=$(basename -- "$ARCHIVO")
  BASE="${NOMBRE%.*}"
  EXT=''
  if [[ $NOMBRE == *.* ]]; then
    EXT="${NOMBRE##*.}"
  else
    BASE="$NOMBRE"
  fi
  if [[ $MODO == lower ]]; then
    NUEVA_BASE="${BASE,,}"
  else
    NUEVA_BASE="${BASE^^}"
  fi
  DIRECTORIO="${ARCHIVO%/*}"
  [[ $DIRECTORIO == "$ARCHIVO" ]] && DIRECTORIO='.'
  DESTINO="$DIRECTORIO/$NUEVA_BASE"
  [[ -n $EXT ]] && DESTINO="$DESTINO.$EXT"
  ORIGINALES+=("$ARCHIVO")
  DESTINOS+=("$DESTINO")
done
for (( i=0; i<${#DESTINOS[@]}; i++ )); do
  if [[ -e ${DESTINOS[i]} && ${DESTINOS[i]} != "${ORIGINALES[i]}" ]]; then
    aba_error "El destino ya existe: ${DESTINOS[i]}"
  fi
  for (( j=i+1; j<${#DESTINOS[@]}; j++ )); do
    if [[ ${DESTINOS[i]} == "${DESTINOS[j]}" && ${ORIGINALES[i]} != "${ORIGINALES[j]}" ]]; then
      aba_error 'Dos archivos tendrían el mismo nombre de destino.'
    fi
  done
done
if ! aba_confirmar "¿Aplicar el cambio a ${#ORIGINALES[@]} archivos?"; then
  aba_notificar "$ABA_TITULO" 'Operación cancelada.'
  exit 0
fi
for (( i=0; i<${#ORIGINALES[@]}; i++ )); do
  [[ ${ORIGINALES[i]} == "${DESTINOS[i]}" ]] && continue
  mv -n -- "${ORIGINALES[i]}" "${DESTINOS[i]}" || aba_error "No se pudo renombrar: ${ORIGINALES[i]}"
done
DIRECTORIO=$(dirname -- "${DESTINOS[0]}")
aba_resultado "Nombres actualizados a $MODO" "$DIRECTORIO"
