#!/bin/bash
set -uo pipefail
LIB="${ABUELAZO_LIB_DIR:-/usr/share/abuelazo-nemo-actions/lib}/abuelazo-common.sh"
[[ -f $LIB ]] || { printf 'No se encontró la librería común de Abuelazo.\n' >&2; exit 1; }
. "$LIB"

aba_requerir_args 1 1 "$#"
ARCHIVO=$(aba_decodificar_uri "$1")
[[ -f $ARCHIVO ]] || aba_error 'No se encuentra la imagen seleccionada.'
if command -v magick >/dev/null 2>&1; then
  IM=magick
else
  IM=convert
fi
aba_requerir "$IM"
BASE="${ARCHIVO%.*}"
[[ $ARCHIVO == *.* ]] || BASE="$ARCHIVO"
SALIDA=$(aba_salida_unica_sufijo "$BASE" '_miniatura' jpg)
LOG=$(aba_log_temporal miniatura)
TEMP=''
trap 'rm -f -- "$LOG"' EXIT
if ! "$IM" "${ARCHIVO}[0]" -auto-orient -background white -flatten -resize '1280x720^' -gravity center -extent 1280x720 -quality 90 -strip "$SALIDA" >"$LOG" 2>&1; then
  aba_error 'No se pudo crear la miniatura.'
fi
KB=$(du -k "$SALIDA" | cut -f1)
if [[ $KB =~ ^[0-9]+$ ]] && (( KB > 2048 )); then
  TEMP=$(mktemp "${TMPDIR:-/tmp}/abuelazo-miniatura-XXXXXX.jpg")
  trap 'rm -f -- "$LOG" "$TEMP"' EXIT
  if "$IM" "${SALIDA}[0]" -quality 82 -strip "$TEMP" >>"$LOG" 2>&1 && mv -f -- "$TEMP" "$SALIDA"; then
    aba_resultado 'Miniatura lista y comprimida' "$SALIDA"
  else
    aba_error 'No se pudo comprimir la miniatura.'
  fi
else
  aba_resultado 'Miniatura lista' "$SALIDA"
fi
